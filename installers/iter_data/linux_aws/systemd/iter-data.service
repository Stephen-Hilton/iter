[Unit]
Description=iter iter_data (API + webui on :@PORT@)
Requires=arangodb3.service
After=arangodb3.service network-online.target
Wants=network-online.target

[Service]
User=iter
Group=iter
Slice=iter.slice
WorkingDirectory=/var/lib/iter
Environment=HOME=/var/lib/iter
EnvironmentFile=/etc/iter/data.env
ExecStart=/opt/iter/bin/iter_data --backend arango --listen 0.0.0.0:@PORT@ --secret-file /var/lib/iter/iter_data.secret --env-file /var/lib/iter/.env
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
