#!/bin/bash
# iter-admin-cleanup: once the first admin has chosen their own password, the
# first-boot ITER_ADMIN_PASSWORD is no longer used: remove it from
# config/data.env (everything else stays, root:iter 640) and, on an AWS stack
# (config/aws.env names STACK= and REGION=), delete the SSM parameter
# /iter/<stack>/admin-password. iter_data writes the marker
# state/admin_password_changed at that moment. Both folders are in iter_data's
# folder, the one above this script's bin/. Run as root by
# iter-admin-cleanup.service (started by iter-admin-cleanup.path when the marker
# appears) and by install.sh (install, status). Idempotent.
set -euo pipefail
D="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
MARKER="$D/state/admin_password_changed"
ENVF="$D/config/data.env"
AWSENV="$D/config/aws.env"
[ -f "$MARKER" ] || { echo "iter-admin-cleanup: no $MARKER yet (the first admin has not chosen a password): nothing to do"; exit 0; }
if [ -f "$ENVF" ] && grep -q '^ITER_ADMIN_PASSWORD=' "$ENVF"; then
  t="$(mktemp "$D/config/.data.env.XXXXXX")"
  grep -v '^ITER_ADMIN_PASSWORD=' "$ENVF" > "$t" || true
  chown root:iter "$t"
  chmod 640 "$t"
  mv -f "$t" "$ENVF"
  echo "iter-admin-cleanup: removed ITER_ADMIN_PASSWORD from $ENVF (the admin chose their own password)"
else
  echo "iter-admin-cleanup: $ENVF holds no ITER_ADMIN_PASSWORD"
fi
if [ -f "$AWSENV" ]; then
  stack="$(sed -n 's/^STACK=//p' "$AWSENV" | tail -1)"
  region="$(sed -n 's/^REGION=//p' "$AWSENV" | tail -1)"
  if [ -n "$stack" ] && [ -n "$region" ]; then
    name="/iter/$stack/admin-password"
    if ! command -v aws >/dev/null; then
      echo "iter-admin-cleanup: no aws CLI: delete $name yourself (aws ssm delete-parameter --name $name)" >&2
    elif out="$(aws ssm delete-parameter --region "$region" --name "$name" 2>&1)"; then
      echo "iter-admin-cleanup: deleted the SSM parameter $name"
    elif printf '%s' "$out" | grep -q ParameterNotFound; then
      echo "iter-admin-cleanup: the SSM parameter $name is already gone"
    else
      echo "iter-admin-cleanup: could not delete $name: $out" >&2
    fi
  fi
fi
