[Unit]
Description=iter online database backup (arangodump, no downtime)
Requires=arangodb3.service
After=arangodb3.service

[Service]
Type=oneshot
User=iter
Group=iter
Nice=10
IOSchedulingClass=idle
EnvironmentFile=@D@/config/data.env
EnvironmentFile=-@D@/config/backup.env
ExecStart=@D@/bin/iter-backup
