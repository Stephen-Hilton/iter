[Unit]
Description=iter engine @ENGINE@
After=network-online.target iter-data.service

[Service]
User=@USER@
WorkingDirectory=@HOME@/.iter
Environment=HOME=@HOME@
Environment=PATH=@HOME@/.local/bin:@HOME@/.cargo/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=@HOME@/.iter/bin/iter_engine --data-url @DATA_URL@ --env-file @HOME@/.iter/.env --name @ENGINE@
StandardOutput=append:@HOME@/.iter/engine.log
StandardError=append:@HOME@/.iter/engine.err.log
Restart=on-failure
RestartSec=10
# a stop takes the agent sessions and shells it started with it
KillMode=control-group

[Install]
WantedBy=multi-user.target
